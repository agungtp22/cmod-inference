FROM rust:1.86-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml ./
COPY src ./src
RUN cargo build --release --locked 2>/dev/null || cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/cmod-inference /usr/local/bin/cmod-inference
COPY config /etc/cmod-inference
ENV CMOD_INFERENCE_BIND=0.0.0.0
ENV CMOD_INFERENCE_PORT=8790
EXPOSE 8790
ENTRYPOINT ["cmod-inference", "serve"]
